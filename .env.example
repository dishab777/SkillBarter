# ==============================================================================
# Supabase PostgreSQL Database Configuration for SkillBarter
# ==============================================================================
# Set these environment variables in your terminal, IDE, or system environment.
# Obtain these values from your Supabase Dashboard:
# Project Settings -> Database -> Connection Parameters / Connection Pooling
#
# NOTE: Do NOT commit your actual .env file or credentials to GitHub!
# ==============================================================================

SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_actual_db_password
